# 環境變數設定檔，此當為通用環境變數
# 因環境建立時是使用Vite，所以下面任何路徑設定的變數名稱前面必須以`VITE_`作為開頭

# 調用此變數時可在頁面中的JS區塊加入`console.log(import.meta.env.VITE_PATH)`做測試
# 正式調用時可改用`const url =import.meta.env.VITE_PATH`

VITE_API_BASE=api_url
VITE_Redirect_BASE=http://localhost:5173/
VITE_FIREBASE_PATH=firebase_url
VITE_GOOGLE_CLIENT_ID=tripeasy-local
# 本機指向 mock-oauth；正式環境改回 https://accounts.google.com/o/oauth2/v2/auth
VITE_GOOGLE_AUTH_URL=http://localhost:8090/google/authorize
